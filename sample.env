# Copy this file as .env, then fill and adapt the actual values.

# --- Deployment / Traefik (docker-compose) ---
JOHNCLOUD_ROOT=/path/to/root/of/paas/data
HOST=douceville.domain.tld
TZ=Etc/UTC
TRAEFIK_NETWORK=traefik-proxy
HOME_GROUP=Bureautique
HOME_NAME=douceville
HOME_ICON=
HOME_DESCRIPTION=Villes et écoles

# --- Observability ---
LOGLEVEL=INFO

# --- Auth (native) ---
# Secret used to sign and verify the JWTs issued by the backend.
# Generate a strong random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Public URL of the service, used in the links sent by e-mail.
PUBLIC_URL=https://douceville.domain.tld

# --- Auth (OpenID Connect, optional) ---
# Leave OIDC_ISSUER_URL empty to disable OIDC login.
# Must match the "issuer" field of .well-known/openid-configuration exactly,
# trailing slash included (e.g. Authentik: https://auth.tld/application/o/<slug>/).
# Register ${PUBLIC_URL}/api/auth/oidc/callback as redirect URI at the provider.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=SSO
OIDC_SCOPES="openid email profile"
# Level given to accounts created via OIDC: verified (awaits admin approval) or granted.
OIDC_DEFAULT_PERMS=verified

# --- E-mail (account verification) ---
# Leave SMTP_HOST empty to only log e-mails (development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Douceville <no-reply@domain.tld>"

# --- Billing (prepaid credit, Mollie, optional) ---
# When enabled, users pay each request from a prepaid balance topped up via Mollie.
# A test_… key simulates payments (no real money); a live_… key charges for real.
BILLING_ENABLED=false
MOLLIE_API_KEY=
# Defaults to ${PUBLIC_URL}/api/billing/webhook/mollie (must be reachable from the Internet).
MOLLIE_WEBHOOK_URL=

# --- External services ---
# Routing provider for isochrones and routes: "ors" (OpenRouteService, default)
# or "valhalla" (self-hosted, see the Valhalla section of README.md).
ROUTING_PROVIDER=ors
OPENROUTESERVICE_KEY=
# Root of a self-hosted OpenRouteService; empty: public API (api.heigit.org).
OPENROUTESERVICE_URL=
# Valhalla service URL (http://valhalla:8002 inside docker compose) and number
# of isochrone requests sent to it in parallel.
VALHALLA_URL=http://localhost:8002
VALHALLA_CONCURRENCY=8
# Maximum number of source établissements per criterion of a search; 0: no cap
# (every établissement of the radius). Empty: 10 with ors, 0 with valhalla.
SOURCES_PAR_NATURE=
# Search cost (cents) above which the UI asks for confirmation; 0: never.
SEARCH_COST_WARNING_CENTS=200
# Valhalla service (docker compose --profile valhalla): public HTTP URL of the
# tiles on the S3-compatible storage, ending with /{tilePath}; optional basic
# auth ("user:password") of a proxy; tile memory cache (bytes); threads.
# The tiles are built and uploaded by scripts/build_valhalla_tiles.sh.
VALHALLA_TILE_URL=
VALHALLA_TILE_URL_USER_PW=
VALHALLA_CACHE_BYTES=300000000
VALHALLA_THREADS=4
# Cache of the isochrones computed for searches: validity in days, and maximum
# number of entries (least recently used ones are evicted beyond it).
ISOCHRONE_CACHE_DAYS=30
ISOCHRONE_CACHE_MAX=20000

# --- Database (PostGIS) ---
POSTGRES_PASSWORD=douceville

TRAEFIK_NETWORK=traefik-proxy
