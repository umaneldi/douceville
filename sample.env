# Copy this file as .env, then fill and adapt the actual values.

# --- Deployment / Traefik (docker-compose) ---
JOHNCLOUD_ROOT=/path/to/root/of/paas/data
HOST=douceville.domain.tld
TZ=Etc/UTC
TRAEFIK_NETWORK=traefik-proxy
HOME_GROUP=Bureautique
HOME_NAME=douceville
HOME_ICON=
HOME_DESCRIPTION=Villes et écoles

# --- Observability ---
LOGLEVEL=INFO

# --- Auth (native) ---
# Secret used to sign and verify the JWTs issued by the backend.
# Generate a strong random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# --- External services ---
OPENROUTESERVICE_KEY=
# Self-hosted addok host (port 7878). Leave empty to use the public BAN API.
ADDOK_HOST=douceville-addok-1

# --- Database (PostGIS) ---
POSTGRES_HOST=douceville-db-1
POSTGRES_PORT=5432
POSTGRES_DB=douceville
POSTGRES_USER=douceville
POSTGRES_PASSWORD=douceville
